<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>전국 시·군 다트 여행</title>
  
  <!-- PWA 필수 메타 태그 -->
  <meta name="theme-color" content="#0b0f19">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

  <style>
    :root {
      --bg-color: #0b0f19;
      --card-bg: #151d2a;
      --border-color: #1e293b;
      --accent-blue: #38bdf8;
      --accent-green: #10b981;
      --accent-red: #f43f5e;
      --text-main: #f3f4f6;
      --text-sub: #9ca3af;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
    body { background-color: var(--bg-color); color: var(--text-main); display: flex; justify-content: center; padding: 12px; min-height: 100vh; }
    .app-container { width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: 12px; }

    /* 상단 탭 */
    .nav-tabs { display: flex; background: var(--card-bg); border-radius: 12px; padding: 4px; border: 1px solid var(--border-color); gap: 4px; }
    .tab-btn { flex: 1; padding: 10px 2px; border: none; background: transparent; color: var(--text-sub); font-size: 0.8rem; font-weight: 600; cursor: pointer; border-radius: 8px; transition: 0.2s; text-align: center; }
    .tab-btn.active { background: #1e293b; color: var(--accent-blue); }

    .panel { display: none; background: var(--card-bg); border-radius: 16px; padding: 16px; border: 1px solid var(--border-color); flex-direction: column; gap: 12px; }
    .panel.active { display: flex; }

    /* 지도/다트 구역 */
    .map-simulator { position: relative; width: 100%; height: 260px; background: #0b0f19; border-radius: 12px; border: 1px solid var(--border-color); display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; }
    .map-bg-text { font-size: 3rem; opacity: 0.05; font-weight: bold; position: absolute; }
    
    /* 다트 애니메이션 대상 */
    .dart-board-area { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
    .target-pin { font-size: 2.5rem; transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    .target-pin.hit { transform: scale(1.4); }

    .result-card { background: #1e293b; padding: 12px; border-radius: 10px; border: 1px solid var(--border-color); text-align: center; }
    .result-title { font-size: 0.85rem; color: var(--text-sub); margin-bottom: 4px; }
    .result-name { font-size: 1.4rem; font-weight: bold; color: var(--accent-blue); }

    .btn-dart { width: 100%; background: var(--accent-green); color: #fff; border: none; padding: 14px; border-radius: 10px; font-weight: bold; font-size: 1rem; cursor: pointer; transition: 0.2s; }
    .btn-dart:active { transform: scale(0.98); }
    .btn-decide { width: 100%; background: var(--accent-red); color: #fff; border: none; padding: 12px; border-radius: 10px; font-weight: bold; font-size: 0.9rem; cursor: pointer; }

    .status-bar { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-sub); padding: 0 4px; }

    /* 기록 및 남은 목록 탭 */
    .list-box { max-height: 320px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; }
    .item-row { display: flex; justify-content: space-between; background: #0b0f19; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-color); font-size: 0.85rem; }
  </style>
</head>
<body>

<div class="app-container">
  <!-- 상단 탭 -->
  <div class="nav-tabs">
    <button class="tab-btn active" onclick="switchTab('tab-main', this)">🎯 다트 던지기</button>
    <button class="tab-btn" onclick="switchTab('tab-history', this)">📅 여행 기록</button>
    <button class="tab-btn" onclick="switchTab('tab-status', this)">🗺️ 남은 지역 (<span id="remaining-count">0</span>)</button>
  </div>

  <!-- TAB 1: 메인 다트 화면 -->
  <div id="tab-main" class="panel active">
    <div class="status-bar">
      <span>대한민국 시·군 무작위 탐험</span>
      <span>중복 제외 모드</span>
    </div>

    <div class="map-simulator">
      <div class="map-bg-text">KOREA</div>
      <div class="dart-board-area">
        <div id="dart-pin" class="target-pin">📍</div>
      </div>
    </div>

    <div class="result-card">
      <div class="result-title">이번에 다트가 꽂힌 곳은?</div>
      <div id="result-text" class="result-name">버튼을 눌러 다트를 던지세요!</div>
    </div>

    <button class="btn-dart" onclick="throwDart()">🎯 다트 던지기!</button>
    <button class="btn-decide" onclick="decideDestination()" style="display:none;" id="btn-decide">❤️ 이 여행지로 확정!</button>
  </div>

  <!-- TAB 2: 여행 기록 -->
  <div id="tab-history" class="panel">
    <h3 style="font-size: 0.95rem;">📅 확정된 여행지 기록</h3>
    <div id="history-list" class="list-box">
      <div style="color: var(--text-sub); font-size: 0.8rem; text-align: center; padding: 20px;">아직 확정된 여행지가 없습니다.</div>
    </div>
  </div>

  <!-- TAB 3: 남은 지역 리스트 -->
  <div id="tab-status" class="panel">
    <h3 style="font-size: 0.95rem;">🗺️ 탐험 가능한 남은 시·군</h3>
    <div id="remaining-list" class="list-box"></div>
  </div>
</div>

<script>
  // 울릉군/독도 제외 대한민국 시·군 전체 데이터 (약 155개)
  let regions = [
    // 서울특별시 (구 단위 대신 서울시 전체로 묶거나 원하시는 단위 조정 가능 - 여기서는 시/군 단위 기준)
    "수원시", "고양시", "용인시", "성남시", "부천시", "화성시", "안산시", "남양주시", "안양시", "평택시", "시흥시", "파주시", "의정부시", "김포시", "광주시", "광명시", "군포시", "하남시", "오산시", "이천시", "안성시", "의왕시", "포천시", "여주시", "동두천시", "과천시", "가평군", "양평군", "연천군",
    // 부산광역시
    "부산진구", "해운대구", "사하구", "금정구", "부산 중구", "부산 동구", "부산 서구", "부산 영도구", "부산 동래구", "부산 남구", "부산 북구", "강서구", "수영구", "사상구", "기장군",
    // 대구광역시
    "대구 중구", "대구 동구", "대구 서구", "대구 남구", "대구 북구", "대구 수성구", "대구 달서구", "달성군", "군위군",
    // 인천광역시
    "인천 중구", "인천 동구", "인천 미추홀구", "인천 연수구", "인천 남동구", "인천 부평구", "인천 계양구", "인천 서구", "강화군", "옹진군",
    // 광주광역시
    "광주 동구", "광주 서구", "광주 남구", "광주 북구", "광주 광산구",
    // 대전광역시
    "대전 동구", "대전 중구", "대전 서구", "대전 유성구", "대전 대덕구",
    // 울산광역시
    "울산 중구", "울산 남구", "울산 동구", "울산 북구", "울주군",
    // 세종특별자치시
    "세종시",
    // 강원특별자치도
    "춘천시", "원주시", "강릉시", "동해시", "태백시", "속초시", "삼척시", "홍천군", "횡성군", "영월군", "평창군", "정선군", "철원군", "화천군", "양구군", "인제군", "고성군", "양양군",
    // 충청북도
    "청주시", "충주시", "제천시", "보은군", "옥천군", "영동군", "증평군", "진천군", "괴산군", "음성군", "단양군",
    // 충청남도
    "천안시", "공주시", "보령시", "아산시", "서산시", "논산시", "계룡시", "당진시", "금산군", "부여군", "서천군", "청양군", "홍성군", "예산군", "태안군",
    // 전북특별자치도
    "전주시", "군산시", "익산시", "정읍시", "남원시", "김제시", "완주군", "진안군", "무주군", "장수군", "임실군", "순창군", "고창군", "부안군",
    // 전라남도
    "목포시", "여수시", "순천시", "나주시", "광양시", "담양군", "곡성군", "구례군", "고흥군", "보성군", "화순군", "장흥군", "강진군", "해남군", "영암군", "무안군", "함평군", "영광군", "장성군", "완도군", "진도군",
    // 경상북도
    "포항시", "경주시", "김천시", "안동시", "구미시", "영주시", "영천시", "상주시", "문경시", "경산시", "의성군", "청송군", "영양군", "영덕군", "청도군", "고령군", "성주군", "칠곡군", "예천군", "봉화군", "울진군",
    // 경상남도
    "창원시", "김해시", "진주시", "양산시", "거제시", "통영시", "사천시", "밀양시", "함안군", "창녕군", "고성군", "남해군", "하동군", "산청군", "함양군", "거창군", "합천군",
    // 제주특별자치도
    "제주시", "서귀포시"
  ];

  let remainingRegions = [...regions];
  let currentSelection = "";
  let historyList = [];

  function switchTab(tabId, btn) {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(tabId).classList.add('active');
    btn.classList.add('active');
    if(tabId === 'tab-status') renderRemainingList();
  }

  let isThrowing = false;
  function throwDart() {
    if (isThrowing) return;
    if (remainingRegions.length === 0) {
      alert("모든 시·군을 다 탐험하셨습니다! 기록을 초기화하거나 다시 시작해주세요.");
      return;
    }

    isThrowing = true;
    const resultText = document.getElementById('result-text');
    const pin = document.getElementById('dart-pin');
    const decideBtn = document.getElementById('btn-decide');
    decideBtn.style.display = 'none';

    pin.classList.remove('hit');
    resultText.innerText = "🎯 다트 날아가는 중...";

    // 셔플 애니메이션 효과 (1.2초 동안 무작위 이름 깜빡이기)
    let count = 0;
    const shuffleInterval = setInterval(() => {
      const randomIndex = Math.floor(Math.random() * remainingRegions.length);
      resultText.innerText = remainingRegions[randomIndex];
      count++;
      if (count > 12) {
        clearInterval(shuffleInterval);
        
        // 최종 당첨 선정
        const finalIndex = Math.floor(Math.random() * remainingRegions.length);
        currentSelection = remainingRegions[finalIndex];
        
        resultText.innerText = `🎉 ${currentSelection} 당첨!`;
        pin.classList.add('hit');
        decideBtn.style.display = 'block';
        isThrowing = false;
      }
    }, 100);
  }

  function decideDestination() {
    if (!currentSelection) return;

    // 남은 지역 배열에서 제거 (중복 제외)
    remainingRegions = remainingRegions.filter(item => item !== currentSelection);
    
    // 기록 추가
    const now = new Date();
    const timeStr = `${now.getMonth()+1}/${now.getDate()} ${now.getHours().toString().padStart(2,'0')}:${now.getMinutes().toString().padStart(2,'0')}`;
    historyList.unshift({ name: currentSelection, time: timeStr });
    renderHistory();

    alert(`❤️ [ ${currentSelection} ] 여행지가 확정되었습니다!`);
    currentSelection = "";
    document.getElementById('result-text').innerText = "다시 던져보세요!";
    document.getElementById('btn-decide').style.display = 'none';
    document.getElementById('dart-pin').classList.remove('hit');
    document.getElementById('remaining-count').innerText = remainingRegions.length;
  }

  function renderHistory() {
    const historyEl = document.getElementById('history-list');
    if (historyList.length === 0) {
      historyEl.innerHTML = '<div style="color: var(--text-sub); font-size: 0.8rem; text-align: center; padding: 20px;">아직 확정된 여행지가 없습니다.</div>';
      return;
    }
    historyEl.innerHTML = historyList.map(item => `
      <div class="item-row">
        <span><b>${item.name}</b></span>
        <span style="color: var(--text-sub); font-size: 0.75rem;">${item.time}</span>
      </div>
    `).join('');
  }

  function renderRemainingList() {
    const listEl = document.getElementById('remaining-list');
    document.getElementById('remaining-count').innerText = remainingRegions.length;
    
    if (remainingRegions.length === 0) {
      listEl.innerHTML = '<div style="color: var(--text-sub); font-size: 0.8rem; text-align: center;">남은 지역이 없습니다.</div>';
      return;
    }
    listEl.innerHTML = remainingRegions.map(item => `
      <div class="item-row">
        <span>${item}</span>
      </div>
    `).join('');
  }

  // 초기 카운트 설정
  document.getElementById('remaining-count').innerText = remainingRegions.length;
</script>
</body>
</html>
